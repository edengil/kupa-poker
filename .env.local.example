# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key
# מתחיל ב-sb_publishable_ . אם יש לך פרויקט ישן עם מפתח anon שמתחיל ב-eyJ,
# גם הוא עובד — השם של המשתנה נשאר זהה בשני המקרים.
# את ה-secret key לעולם לא שמים כאן.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# כתובת האתר (לוקאלית: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# אופציונלי — פקודות מקבוצת הוואטסאפ ("דן עוד 50")
# בלי המשתנים האלה האפליקציה עובדת רגיל, פשוט בלי הבוט.
# ---------------------------------------------------------------------------

# סוד שממציאים לבד. הוא נוסף לכתובת ה-webhook ומונע מזרים לדפוק בדלת.
WHATSAPP_WEBHOOK_SECRET=

# Whapi → Dashboard → API token
WHAPI_TOKEN=

# מזהה הקבוצה. מקבלים אותו מ-GET /api/whatsapp?secret=<הסוד>&
WHAPI_GROUP_ID=

# מספר הטלפון שלך. רק ממנו מתקבלות פקודות.
WHATSAPP_OWNER=972501234567

# ה-slug מהלינק לשיתוף — החלק שאחרי /g/
KUPA_GROUP_SLUG=

# Supabase → API Keys → Secret keys. שים לב: בלי NEXT_PUBLIC_ ,
# אחרת הוא ייכנס לחבילת הדפדפן וכל אחד יוכל לקרוא ולמחוק הכל.
SUPABASE_SECRET_KEY=
