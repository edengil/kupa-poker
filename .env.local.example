# ============================================================================
# כל משתני הסביבה שהקוד קורא — מלאי מלא (גל 4ב, ממצא ביקורת 16).
# השמות כאן הם בדיוק השמות שהקוד מחפש; שם שגוי = המשתנה לא נקרא, בשקט.
# חובה להפעלה בסיסית: שלושת הראשונים. כל השאר — לפי התכונות שמפעילים.
# ============================================================================

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (מתחיל ב־sb_publishable_)
# זה השם היחיד שהקוד קורא. שם ה־anon הישן (NEXT_PUBLIC_SUPABASE_ANON_KEY)
# לא נקרא בשום מקום — מי שמגדיר רק אותו מקבל אפליקציה בלי מפתח.
# את ה-secret key לעולם לא שמים כאן.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# כתובת האתר (לוקאלית: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → API Keys → Secret keys. שים לב: בלי NEXT_PUBLIC_ ,
# אחרת הוא ייכנס לחבילת הדפדפן וכל אחד יוכל לקרוא ולמחוק הכל.
SUPABASE_SECRET_KEY=

# ה-slug מהלינק לשיתוף — החלק שאחרי /g/ (השרת משתמש בו לאתר את הקבוצה)
KUPA_GROUP_SLUG=

# כתובת הייצור ש־Vercel חושף אוטומטית (VERCEL_PROJECT_PRODUCTION_URL) —
# משמשת נפילה לכתובת האתר כש־NEXT_PUBLIC_SITE_URL לא הוגדר. ב־Vercel
# אין צורך להגדיר ידנית; מקומית אפשר להשאיר ריק.
VERCEL_PROJECT_PRODUCTION_URL=

# ---------------------------------------------------------------------------
# אופציונלי — פקודות מקבוצת הוואטסאפ ("דן עוד 50")
# בלי המשתנים האלה האפליקציה עובדת רגיל, פשוט בלי הבוט.
# ---------------------------------------------------------------------------

# סוד שממציאים לבד. הוא נוסף לכתובת ה-webhook ומונע מזרים לדפוק בדלת.
# מאז גל 4ב זהו סוד ה־webhook בלבד — לקרונים ולניהול יש סודות משלהם למטה.
WHATSAPP_WEBHOOK_SECRET=

# Whapi → Dashboard → API token
WHAPI_TOKEN=

# מזהה קבוצת הוואטסאפ. מקבלים אותו מ-GET /api/whatsapp?secret=<הסוד>&
WHAPI_GROUP_ID=

# מספר הטלפון שלך. רק ממנו ומהמספרים המאושרים מתקבלות פקודות.
WHATSAPP_OWNER=972501234567

# מספרים נוספים שמורשים לפקוד על הבוט (מופרדים בפסיק/רווח). ריק = רק הבעלים.
WHATSAPP_ALLOWED=

# טוקן ייעודי לנתיב התזכורות /api/wa-reminders כשמפעיל אותו pg_cron מהמסד
# (כותרת Bearer). ריק = הנתיב מסתפק באימות ה־cron הרגיל.
WA_REMINDERS_TOKEN=

# מארחי הערב להזמנות ולכפתורי המיקום: מערך JSON של {slug, label, text}.
# הכתובות וקודי הבניינים חיים כאן, לא בקוד (גל 4ב, ממצא 17).
# דוגמה במבנה בלבד (ערכים בדיוניים):
# KUPA_HOSTS_JSON=[{"slug":"dani","label":"דני","text":"אצל דני · הפרחים 3, עיר הדוגמה · קומה 4, דירה 12 · קוד בניין #1234#"}]
KUPA_HOSTS_JSON=

# ---------------------------------------------------------------------------
# אופציונלי — שערי ניהול וקרונים (הפרדת סודות לפי תפקיד, גל 4ב, ממצא 23)
# ---------------------------------------------------------------------------

# סוד שערי הניהול בלבד: /api/health ו־/api/whapi-setup (?secret=).
# כשלא מוגדר, השערים נופלים לסוד ה־webhook (תאימות־אחורה); מהרגע
# שמגדירים אותו — רק הוא פותח את השערים.
ADMIN_SECRET=

# סוד שממציאים לבד; Vercel שולח אותו אוטומטית בכותרת Bearer של קריאות
# ה-cron שלו. כל עוד הוא לא מוגדר מתקבלות גם הנפילות הישנות (סוד ה־webhook
# ב־?secret= וכותרת x-vercel-cron) — ראו lib/cronAuth.js.
CRON_SECRET=

# ---------------------------------------------------------------------------
# אופציונלי — התראות פוש לצופים ("המשחק התחיל")
# יוצרים זוג מפתחות פעם אחת:  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------

# המפתח הציבורי — כן עם NEXT_PUBLIC_, הדפדפן צריך אותו כדי להירשם
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# המפתח הפרטי — בלי NEXT_PUBLIC_, נשאר בשרת בלבד
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# אופציונלי — אישורי הגעה במייל + חתימת טוקנים
# ---------------------------------------------------------------------------

# מפתח חתימה לטוקני אישור־ההגעה במייל. ריק = נופלים למפתח הסודי של Supabase.
RSVP_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# אופציונלי — התראות תקלה במייל וב-webhook
# שולח הדוחות וההתראות הוא חשבון Gmail עם App Password.
# ---------------------------------------------------------------------------

GMAIL_USER=
GMAIL_APP_PASSWORD=

# כתובת היעד להתראות תקלה (ריק = ברירת המחדל בקוד)
ALERT_EMAIL_TO=

# כתובת webhook (Discord/Slack) להתראות שגיאות שרת, בנוסף למייל
ERROR_ALERT_WEBHOOK=

# ---------------------------------------------------------------------------
# אופציונלי — חיבור Google Calendar (אירועי ערב + סנכרון)
# OAuth client מ־Google Cloud Console. ה-refresh token כאן הוא הגלובלי;
# חיבור דרך האפליקציה שומר טוקן פר־קבוצה במסד (calendar_credentials)
# וקודם לו. אם הכול חסר — הפיצ'ר כבוי בשקט.
# ---------------------------------------------------------------------------

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# אופציונלי — אנליטיקס ומצב תצוגה־מקדימה
# ---------------------------------------------------------------------------

# מפתח Amplitude ציבורי (דפדפן). ריק = אין אנליטיקס.
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# 1 = מאפשר את עמוד התצוגה־המקדימה /preview גם מחוץ ל־dev. להשאיר ריק בייצור.
ALLOW_PREVIEW=
